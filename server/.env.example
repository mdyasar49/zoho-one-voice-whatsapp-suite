PORT=5000
NODE_ENV=development

# Meta WhatsApp Cloud API Credentials
WHATSAPP_TOKEN=your_meta_whatsapp_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=zoho_whatsapp_webhook_secret_2026

# Google Gemini AI API Key for Copilot
GEMINI_API_KEY=your_gemini_api_key

# Zoho CRM OAuth Credentials
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REDIRECT_URI=http://localhost:5000/api/zoho/callback
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in/crm/v3
